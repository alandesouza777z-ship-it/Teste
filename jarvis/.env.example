# Copie este arquivo para .env e preencha.

# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Como o JARVIS te chama
JARVIS_NOME_USUARIO=senhor

# Escuta: continua (ouve tudo o que você fala, sem precisar dizer "Jarvis") ou palavra (só depois de "Jarvis")
JARVIS_ESCUTA=continua

# Tamanho das respostas ao abrir: curta, moderada ou longa (também muda pelos botões ou pela voz)
JARVIS_MODO_RESPOSTA=curta

# Palavra de ativação (diga "Jarvis, ..." para falar com ele)
JARVIS_PALAVRA_ATIVACAO=jarvis

# Voz (Microsoft Edge neural, gratuita). Rode "python testar_vozes.py" para ouvir e comparar.
#   pt-BR-AntonioNeural              (masculina, brasileira — padrão)
#   en-US-AndrewMultilingualNeural   (masculina, muito natural, leve sotaque)
#   en-US-BrianMultilingualNeural    (masculina, grave, leve sotaque)
#   pt-BR-ThalitaMultilingualNeural  (feminina, muito natural)
JARVIS_VOZ=pt-BR-AntonioNeural
JARVIS_VELOCIDADE_VOZ=+8%
JARVIS_TOM_VOZ=+0Hz

# Efeito "JARVIS" na voz (presença metálica e ambiente de sala). 0 desliga.
JARVIS_EFEITO_VOZ=1

# Voz premium opcional (ElevenLabs, pago): escolha uma voz na biblioteca deles e cole o ID aqui.
ELEVENLABS_API_KEY=
ELEVENLABS_VOZ=

# Reconhecimento de voz ULTRARRÁPIDO e mais preciso (recomendado): crie uma chave grátis em
# https://console.groq.com/keys e cole aqui. Sem ela, o JARVIS usa o reconhecimento no seu PC.
GROQ_API_KEY=

# Atendimento de clientes no WhatsApp: confirmar (lê a resposta e pergunta antes de enviar) ou automatico
JARVIS_ATENDIMENTO=confirmar

# Reconhecimento de voz: whisper (preciso, roda no seu PC) ou google (online).
JARVIS_RECONHECIMENTO=whisper
# Modelo do Whisper: base (rápido), small (padrão), medium (mais preciso, precisa de PC forte)
JARVIS_WHISPER_MODELO=small

# Palmas: aumente (ex.: 1.5) se ele não reconhecer suas palmas; diminua (ex.: 0.7) se abrir sozinho.
JARVIS_PALMAS_SENSIBILIDADE=1.0
# Música que toca no Spotify junto com as palmas (link spotify:track:...). Deixe vazio para desligar.
JARVIS_PALMAS_MUSICA=spotify:track:08mG3Y1vljYA6bvDt4Wqkj
JARVIS_PALMAS_MUSICA_NOME=Back In Black
# Sites que abrem no Google Chrome com as palmas (separados por vírgula). Vazio = nenhum.
JARVIS_PALMAS_SITES=https://claude.ai,https://vaultsistemas.com/hoje
# Abrir o WhatsApp Web e dizer as conversas não lidas (0 desliga).
JARVIS_PALMAS_WHATSAPP=1

# Spotify (https://developer.spotify.com/dashboard -> Create app)
# Redirect URI cadastrada no app: http://127.0.0.1:8888/callback
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
